{
  "name": "live-deposit-monitor",
  "version": "1.0.0",
  "description": "Live Deposit Monitoring System - Production Desktop Application",
  "main": "dist/main/main/index.js",
  "author": "Deposit Monitor Team",
  "license": "MIT",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-builder install-app-deps",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\" \"npm run start:dev\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "start:dev": "wait-on http://localhost:5173 && wait-on dist/main/main/index.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "electron .",
    "bundle:browser": "node scripts/bundle-browser.js",
    "verify:browser-bundle": "node scripts/verify-browser-bundle.js",
    "test:phase0": "npm run build:main && node scripts/verify-phase0-baseline.js",
    "test:phase0:sqlite": "npm run build:main && cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/verify-phase0-sqlite-runtime.js",
    "test:phase0:all": "npm run test:phase0 && npm run test:phase0:sqlite",
    "test:phase1:recovery": "npm run build:main && node scripts/verify-phase1-recovery.js",
    "test:phase1:sqlite": "npm run build:main && cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/verify-phase1-sqlite-recovery.js",
    "test:phase2:source": "npm run build:main && node scripts/verify-phase2-source.js",
    "test:phase3:filter-resolution": "npm run build:main && node scripts/verify-phase3-filter-resolution.js",
    "portable:summary": "node scripts/portable-build-summary.js",
    "prepack:portable": "npm run bundle:browser && npm run verify:browser-bundle",
    "dist": "npm run build && npm run prepack:portable && electron-builder --win --x64 && npm run portable:summary",
    "dist:portable": "npm run build && npm run prepack:portable && electron-builder --win portable --x64 && npm run portable:summary",
    "clean": "rimraf dist dist-build",
    "test:phase4:html-parser": "npm run build:main && node scripts/verify-phase4-html-parser.js",
    "test:phase5:parser-parity": "npm run build:main && node scripts/verify-phase5-parser-parity.js",
    "test:phase6:fast-http": "npm run build:main && node scripts/verify-phase6-fast-http-worker.js"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.0",
    "cheerio": "1.0.0",
    "google-auth-library": "^9.6.3",
    "googleapis": "^131.0.0",
    "playwright": "1.42.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.9",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-window": "^1.8.10",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.depositmonitor.app",
    "productName": "Live Deposit Monitor",
    "directories": {
      "output": "dist-build",
      "buildResources": "assets"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Live Deposit Monitor"
    },
    "portable": {
      "artifactName": "LiveDepositMonitor-Portable.exe"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/browsers",
        "to": "browsers",
        "filter": ["**/*"]
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*",
      "**/*.node"
    ]
  }
}
